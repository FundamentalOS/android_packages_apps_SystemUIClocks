        "alignment": {
          "horizontalAlignment": "CENTER",
          "verticalAlignment": "BOTTOM"
        },
        "dateTimeFormat": "hh"
      },
      {
        "type": "digital-hand",
        "timespec": "DIGIT_PAIR",
        "style": {
          "type": "font-style",
          "fontSizeScale": 1.25,
          "fontVariation": "'wght' 500",
          "fontFamily": "growth.ttf",
          "lineHeight": 221.88
        },
        "aodStyle": {
          "type": "font-style",
          "fontSizeScale": 1.06,
          "fontVariation": "'wght' 50",
          "borderWidth": "0dp",
          "fillColorLight": "@android:color/system_accent1_100",
          "renderType": "CHANGE_WEIGHT"
        },
        "alignment": {
          "horizontalAlignment": "CENTER",
