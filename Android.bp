//
// Open-source lockscreen clock plugins for the Pixel 9 family (caimito). Each apk is a SystemUI
// ClockProviderPlugin (discovered via com.android.systemui.action.PLUGIN_CLOCK_PROVIDER) that
// renders one of the clock designs shipped on stock Pixel. The rendering engine
// (com.android.systemui.clocks, engine/) is FundamentalOS' own code built on the AOSP plugin API
// (SystemUIPluginLib) and clock helpers (SystemUIClocks-CommonLib); the per-clock artwork under
// clocks/*/{assets,res} is Google's, copied verbatim so the clocks render identically.
//
// The apks are platform-signed so they share SystemUI's signature and are granted the
// signature-level com.android.systemui.permission.PLUGIN the plugin loader requires, and they are
// installed at the stock location (system_ext/priv-app/SystemUIClocks-*) with the stock package
// names so the existing config_pluginAllowlist entries cover them.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Shared engine (no artwork), linked into each clock apk.
android_library {
    name: "FundamentalClocksEngine",
    manifest: "engine/AndroidManifest.xml",
    srcs: ["engine/src/**/*.kt"],
    resource_dirs: ["engine/res"],
    use_resource_processor: true,
    libs: ["SystemUIPluginLib"],
    static_libs: [
        "SystemUIClocks-CommonLib",
        "PlatformAnimationLib",
        "PlatformComposeSceneTransitionLayout",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation-layout",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core",
        "gson",
        "lottie",
        "monet",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "current",
    platform_apis: true,
    system_ext_specific: true,
}

java_defaults {
    name: "FundamentalClocksAppDefaults",
    use_resource_processor: true,
    libs: ["SystemUIPluginLib"],
    static_libs: ["FundamentalClocksEngine"],
    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "current",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    certificate: "platform",
    // Dex shrinking only: the artwork is referenced by name from the JSON designs (via
    // Resources.getIdentifier), which the resource shrinker cannot see.
    optimize: {
        enabled: true,
        shrink_resources: false,
        proguard_flags_files: ["proguard.flags"],
    },
}

android_app {
    name: "SystemUIClocks-BigNum",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/bignum/AndroidManifest.xml",
    srcs: ["clocks/bignum/src/**/*.kt"],
    resource_dirs: ["clocks/bignum/res"],
    asset_dirs: ["clocks/bignum/assets"],
}

android_app {
    name: "SystemUIClocks-Calligraphy",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/calligraphy/AndroidManifest.xml",
    srcs: ["clocks/calligraphy/src/**/*.kt"],
    resource_dirs: ["clocks/calligraphy/res"],
    asset_dirs: ["clocks/calligraphy/assets"],
}

android_app {
    name: "SystemUIClocks-Growth",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/growth/AndroidManifest.xml",
    srcs: ["clocks/growth/src/**/*.kt"],
    resource_dirs: ["clocks/growth/res"],
    asset_dirs: ["clocks/growth/assets"],
}

android_app {
    name: "SystemUIClocks-Inflate",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/inflate/AndroidManifest.xml",
    srcs: ["clocks/inflate/src/**/*.kt"],
    resource_dirs: ["clocks/inflate/res"],
    asset_dirs: ["clocks/inflate/assets"],
}

android_app {
    name: "SystemUIClocks-Metro",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/metro/AndroidManifest.xml",
    srcs: ["clocks/metro/src/**/*.kt"],
    resource_dirs: ["clocks/metro/res"],
    asset_dirs: ["clocks/metro/assets"],
}

android_app {
    name: "SystemUIClocks-NumOverlap",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/numoverlap/AndroidManifest.xml",
    srcs: ["clocks/numoverlap/src/**/*.kt"],
    resource_dirs: ["clocks/numoverlap/res"],
    asset_dirs: ["clocks/numoverlap/assets"],
}

android_app {
    name: "SystemUIClocks-Weather",
    defaults: ["FundamentalClocksAppDefaults"],
    manifest: "clocks/weather/AndroidManifest.xml",
    srcs: ["clocks/weather/src/**/*.kt"],
    resource_dirs: ["clocks/weather/res"],
    asset_dirs: ["clocks/weather/assets"],
}
