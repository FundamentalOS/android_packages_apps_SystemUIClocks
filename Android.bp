        enabled: false,
    },
}

android_app_import {
    name: "SystemUIClocks-NumOverlap",
    apk: "proprietary/system_ext/priv-app/SystemUIClocks-NumOverlap/SystemUIClocks-NumOverlap.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "SystemUIClocks-Weather",
    apk: "proprietary/system_ext/priv-app/SystemUIClocks-Weather/SystemUIClocks-Weather.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
