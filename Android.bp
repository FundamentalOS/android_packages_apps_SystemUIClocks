// Pixel lockscreen clock-face plugins for the Pixel 9 family (caimito), extracted from the
// stock BP4A factory image. Each APK is a SystemUI ClockProviderPlugin, discovered at runtime
// via the com.android.systemui.action.PLUGIN_CLOCK_PROVIDER intent and rendered on the
// keyguard / clock picker.
//
// Re-signed with the platform key (certificate: "platform") so they share SystemUI's
// signature and are granted the signature-level com.android.systemui.permission.PLUGIN
// (the plugin loader requires it); installed as privileged system_ext apps at the stock location
// (system_ext/priv-app/SystemUIClocks-*). com.android.systemui.permission.PLUGIN is a
// signature permission, so plugin loading is NOT gated on the signature: on user builds
// SystemUI only loads plugins whose package is in config_pluginAllowlist (the 7 packages
// below are added there in vendor/fundamental/overlay/common); on userdebug the gate is
// bypassed entirely (ro.debuggable).

android_app_import {
    name: "SystemUIClocks-BigNum",
    apk: "proprietary/system_ext/priv-app/SystemUIClocks-BigNum/SystemUIClocks-BigNum.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "SystemUIClocks-Calligraphy",
    apk: "proprietary/system_ext/priv-app/SystemUIClocks-Calligraphy/SystemUIClocks-Calligraphy.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

